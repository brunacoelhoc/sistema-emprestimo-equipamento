# Copie este arquivo para ".env" e preencha com os valores reais do seu ambiente.
# NUNCA coloque valores reais aqui neste arquivo (ele vai pro Git).

# String de conexao do PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/emprestimo_equipamentos?schema=public"

# Porta em que a API vai rodar (opcional, padrao 3000 se nao definida)
PORT=3000

# Chave secreta usada para assinar/validar os tokens JWT.
# Gere uma aleatoria, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-longa-e-secreta"
